#!/bin/bash

# Github workflow schedule is very unreliable, so to run this script, run `crontab -e` on your PC and add following command:
# */5 * * * * export GH_TOKEN=<your Github token> ; [ $(gh run list --repo=pelya/termux-packages --status in_progress | wc -l) -le 2 ] && gh workflow run --repo pelya/termux-packages random_package.yml 2>&1 | logger --tag cronjob

export TERMUX_SCRIPTDIR
TERMUX_SCRIPTDIR=$(realpath "$(dirname "$0")/../..") # Root of repository.

cd "${TERMUX_SCRIPTDIR}" || exit 1

no_of_total_packages=0

total_packages=$(find packages root-packages x11-packages -mindepth 1 -maxdepth 1 -type d | sort)

[ -n "${total_packages}" ] && no_of_total_packages=$(echo "${total_packages}" | wc -l)
no_of_built_packages=0

for repo in $(jq --raw-output 'del(.pkg_format) | keys | .[]' repo.json); do
  REPOSITORY_NAME=$(jq --raw-output '.["'$repo'"].name' repo.json)
  REPOSITORY_DISTRIBUTION=$(jq --raw-output '.["'$repo'"].distribution' repo.json)
  REPOSITORY_COMPONENT=$(jq --raw-output '.["'$repo'"].component' repo.json)
  REPOSITORY_URL=$(jq --raw-output '.["'$repo'"].url' repo.json)
  # aarch64 is the primary architecture - there are no packages which have aarch64 in TERMUX_PKG_EXCLUDED_ARCHES
  [ -f $REPOSITORY_NAME.pkglist ] || \
    curl -L "$REPOSITORY_URL/dists/$REPOSITORY_DISTRIBUTION/$REPOSITORY_COMPONENT/binary-aarch64/Packages" \
      -o $REPOSITORY_NAME.pkglist >/dev/null || exit 1
done

for pkg in ${total_packages}; do
  pkg=$(basename ${pkg})
  if grep -Fx "Package: ${pkg}" *.pkglist >/dev/null; then
    no_of_built_packages=$(expr ${no_of_built_packages} + 1)
  fi
done

echo "Packages: ${no_of_total_packages} total, ${no_of_built_packages} built, $(wc -l <build-failed.txt) failed." >&2

for i in `seq 100`; do
  random_package_no=$(shuf -i 1-"${no_of_total_packages}" -n 1)
  random_package=$(echo "${total_packages}" | head -n"${random_package_no}" | tail -n1)
  random_package=$(basename ${random_package})
  if grep -Fx "Package: ${random_package}" *.pkglist >/dev/null; then
    continue
  fi
  if [ -f build-failed.txt ] \
      && grep -Fx "${random_package}" build-failed.txt >/dev/null; then
    continue
  fi
  echo "${random_package}"
  break
done
